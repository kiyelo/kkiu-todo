{
  "name": "kkiu-todo",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test:stress": "node scripts/stress-test.mjs",
    "test:sync": "node scripts/remote-sync-test.mjs",
    "test:release-config": "node scripts/release-config-test.mjs",
    "test:architecture": "node scripts/architecture-test.mjs",
    "verify:checks": "pnpm run test:stress && pnpm run test:sync && pnpm run test:release-config && pnpm run test:architecture",
    "verify:release": "pnpm run verify:checks && pnpm run build",
    "verify:web": "vite build",
    "build:android:web": "cross-env CAPACITOR_BUILD=1 vite build",
    "build:android": "pnpm run build:android:web && cap sync android",
    "verify:android-sync": "node scripts/verify-android-sync.mjs",
    "build:android:verified": "pnpm run build:android && pnpm run verify:android-sync",
    "build:apk": "node scripts/build-apk.mjs",
    "android:add": "cap add android",
    "android:run": "cap run android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@cap-kit/settings": "8.1.5",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@supabase/supabase-js": "2.110.7",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@vitejs/plugin-react": "6.0.3",
    "cross-env": "10.1.0",
    "vite": "8.1.5"
  }
}
